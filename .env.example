# Optional. If set, the contact form POSTs JSON to this endpoint
# (Formspree or any compatible inbox). Example:
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
#
# If unset, submit opens a mailto: draft to accounts@cohesyshealth.com
# with the form fields in the encoded body.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
